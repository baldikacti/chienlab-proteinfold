// Module specific configurations
process {
    withName: 'POOL' {
                ext.args = { [
                    params.pool_mode ? "--mode ${params.pool_mode}" : null,
                    params.max_pool_depth ? "--max-pool-depth ${params.max_pool_depth}" : null,
                    params.pool_seed != null ? "--seed ${params.pool_seed}" : null,
                    params.max_pools != null ? "--max-pools ${params.max_pools}" : null,
                ].findAll().join(' ')}
            }
}
