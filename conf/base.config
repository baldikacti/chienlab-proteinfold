/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

params {

    // GPU VRAM tiers, per prediction mode.
    gpu_vram_tiers = [
        'alphafold3': [
            [ max_depth: 1024, constraint: 'vram23' ],
            [ max_depth: 2560, constraint: 'vram40' ],
            [ max_depth: 5120, constraint: 'vram80' ],
        ],
        'boltz': [
            [ max_depth: 1024, constraint: 'vram23' ],
            [ max_depth: 2560, constraint: 'vram40' ],
            [ max_depth: 5120, constraint: 'vram80' ],
        ],
        'colabfold': [
            [ max_depth: 500, constraint: 'vram23' ],
            [ max_depth: 2000, constraint: 'vram40' ],
            [ max_depth: 3500, constraint: 'vram80' ],
        ],
        'default': [
            [ max_depth: 1024, constraint: 'vram23' ],
            [ max_depth: 2560, constraint: 'vram40' ],
            [ max_depth: 5120, constraint: 'vram80' ],
        ],
    ]

    // Minimum GPU compute capability required by each mode
    gpu_sm_arch = [
        'alphafold3': 'sm_80',
        'boltz'     : 'sm_70',
        'colabfold' : 'sm_70'
    ]
}

process {

    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 2.h  * task.attempt }

    maxRetries = 2
    errorStrategy = { task.attempt <= process.maxRetries  ? 'retry' : 'terminate' }

    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 10     * task.attempt }
        memory = { 100.GB * task.attempt }
        time   = { 8.h    * task.attempt }
    }
    withLabel:gpu {
        // If a process has gpu label submits to gpu queue
        queue = { task.time <= 2.h ? 'gpu-preempt' : 'gpu' }
        clusterOptions = {
            def mode  = params.mode as String
            def all   = params.gpu_vram_tiers as Map
            def tiers = (all[mode] ?: all['default']) as List
            def fitting = tiers.findAll { tier -> params.max_pool_depth <= (tier as Map).max_depth }
            def first = params.pool ? tiers.size() - fitting.size() : 0

            // Each retry escalates one tier, capped at the largest GPU
            def tier = tiers[Math.min(first + task.attempt - 1, tiers.size() - 1)] as Map
            def constraints = [tier.constraint as String, (params.gpu_sm_arch as Map)[mode] as String]
                .findAll { c -> c }
                .join(',')

            return "--gpus=1 --constraint=${constraints}"
        }
        containerOptions = '--nv'

        cpus   = { 1                    }
        memory = { 30.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = { task.attempt <= process.maxRetries  ? 'retry' : 'ignore' }
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}