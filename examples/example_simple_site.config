/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Simple site configuration - Custom Site
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Every AF3_FOLD job gets an 80 GB GPU, which fits pools of up to ~5000 amino
    acids. See `example.config` for a version that sizes the GPU per job.

    Usage:
        nextflow run baldikacti/chienlab-proteinfold \
            -c examples/example_simple.config \
            -params-file examples/example_af3_pool.yaml \
            --mode alphafold3
----------------------------------------------------------------------------------------
*/

params {
    // Largest pool, in amino acids, to predict in one job
    max_pool_depth = 4000
}

process {

    withName: 'AF3_FOLD' {
        // vram80 GPUs live only in the high-VRAM partitions; short jobs go to the
        // preemptable one, which has a much shorter queue
        queue          = { task.time <= 2.h ? 'gpu-preempt-highvram' : 'gpu-highvram' }
        clusterOptions = '--gpus=1 --constraint=vram80,sm_80'

        cpus   = 1
        memory = { 40.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    resourceLimits = [
        cpus: 192,
        memory: 1500.GB,
        time: 5.d
    ]
    executor = 'slurm'

    // Selects partition based on process time
    queue = { task.time <= 2.h ? 'cpu-preempt' : 'cpu' }
    clusterOptions = { "${task.time >= 48.h ? '-q long' : ''}" }

    maxRetries = 2
}

executor {
    queueSize = 500
    submitRateLimit = '5sec'
    pollInterval = 1.m
    queueStatInterval = 2.m
}

apptainer {
    enabled = true
    autoMounts = true
    pullTimeout = 120.m
}
