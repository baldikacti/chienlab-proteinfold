/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Example site configuration - Unity (SLURM)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Usage:
        nextflow run baldikacti/chienlab-proteinfold \
            -profile unity \
            -c examples/example.config \
            -params-file examples/example_af3_pool.yaml
----------------------------------------------------------------------------------------
*/

params {

    // GPU tiers, smallest VRAM first: the Slurm node feature and the partition that
    // holds those nodes. `vram48` and larger GPUs live only in the high-VRAM partitions.
    gpu_tiers = [
        [ constraint: 'vram23', partition: 'gpu'          ],
        [ constraint: 'vram48', partition: 'gpu-highvram' ],
        [ constraint: 'vram80', partition: 'gpu-highvram' ],
    ]

    // Per GPU process: minimum compute capability, and the largest pool (in amino
    // acids) each tier above is expected to hold (one entry per tier, ascending).
    gpu_tools = [
        'AF3_FOLD'       : [ arch: 'sm_80', max_depth: [ 1024, 2560, 5120 ] ],
        'BOLTZ_PREDICT'  : [ arch: 'sm_70', max_depth: [ 1024, 2560, 5120 ] ],
        'COLABFOLD_BATCH': [ arch: 'sm_70', max_depth: [  500, 2000, 3500 ] ],
        'default'        : [ arch: null,    max_depth: [ 1024, 2560, 5120 ] ],
    ]
}

process {

    withLabel:process_gpu {

        // The partition is chosen together with the GPU tier in `clusterOptions`
        queue = null

        clusterOptions = {
            // `task.process` is fully qualified (e.g. BOLTZ:BOLTZ_PREDICT)
            def tools = params.gpu_tools as Map
            def tool  = (tools[task.process.tokenize(':').last()] ?: tools['default']) as Map
            def tiers = params.gpu_tiers as List
            def depth = params.pool ? params.max_pool_depth as Integer : 0

            // Start at the smallest tier that fits the pool (limits are ascending, so
            // that is the number of tiers too small for it) and escalate one tier per
            // retry, capped at the largest GPU
            def first = (tool.max_depth as List).findAll { max -> depth > (max as Integer) }.size()
            def tier  = tiers[Math.min(first + task.attempt - 1, tiers.size() - 1)] as Map

            // Short jobs go to the preemptable partition, which has a much shorter queue
            // (gpu -> gpu-preempt, gpu-highvram -> gpu-preempt-highvram)
            def partition  = (tier.partition as String).replace('gpu', task.time <= 2.h ? 'gpu-preempt' : 'gpu')
            def constraint = [tier.constraint, tool.arch].findAll { c -> c }.join(',')
            def gpus       = (task.accelerator?.request as Integer) ?: 1

            "--partition=${partition} --gpus=${gpus} --constraint=${constraint}"
        }

        containerOptions = '--nv'
        
        cpus   = 1
        memory = { 40.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
}
